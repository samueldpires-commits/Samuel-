# Copie para .env e preencha. NUNCA suba o .env para o Git.
# Gere um segredo com:  npm run gen-secret
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
PORT=3000
# development | production  (em production o cookie exige HTTPS)
NODE_ENV=development
# Se estiver atrás de proxy/reverse proxy (Nginx, Render, Railway...), use 1
TRUST_PROXY=0
